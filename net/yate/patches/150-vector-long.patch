--- a/engine/String.cpp
+++ b/engine/String.cpp
@@ -1180,6 +1180,20 @@ String& String::operator+=(double value)
     return operator+=(buf);
 }
 
+String& String::operator+=(long value)
+{
+    char buf[24];
+    ::sprintf(buf,"%ld",value);
+    return operator+=(buf);
+}
+
+String& String::operator+=(unsigned long value)
+{
+    char buf[24];
+    ::sprintf(buf,"%lu",value);
+    return operator+=(buf);
+}
